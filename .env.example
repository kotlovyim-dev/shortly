# Development only. Generate unique secrets before deploying.
POSTGRES_PASSWORD=shortly_dev_pg
MONGO_PASSWORD=shortly_dev_mongo
REDIS_PASSWORD=shortly_dev_redis
DATABASE_URL=postgresql://shortly:shortly_dev_pg@localhost:5432/shortly
MONGODB_URI=mongodb://shortly:shortly_dev_mongo@localhost:27017/shortly?authSource=admin
REDIS_URL=redis://:shortly_dev_redis@localhost:6379
JWT_SECRET=development-only-replace-with-at-least-32-random-bytes
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Exact proxy IPs/CIDRs, never blindly trust incoming forwarded headers.
TRUST_PROXY=loopback
ANALYTICS_RETENTION_DAYS=90
